    JOB_ROLES ||--o{ EVALUATION_TEMPLATES : has
    JOB_ROLES ||--o{ SHORTLISTS : has

    CANDIDATES ||--o{ CANDIDATE_DOCUMENTS : has
    CANDIDATES ||--o{ SCREENING_RUNS : has
    CANDIDATES ||--o{ SHORTLIST_CANDIDATES : appears_in

    EVALUATION_TEMPLATES ||--o{ EVALUATION_CRITERIA : contains
    EVALUATION_TEMPLATES ||--o{ SCREENING_RUNS : used_for

    SCREENING_RUNS ||--o{ SCREENING_EVIDENCE : produces
    SCREENING_RUNS ||--o{ SCREENING_SCORES : produces
    SCREENING_RUNS ||--o{ SHORTLIST_CANDIDATES : supports

    EVALUATION_CRITERIA ||--o{ SCREENING_EVIDENCE : evaluated_by
    EVALUATION_CRITERIA ||--o{ SCREENING_SCORES : scored_by

    CANDIDATE_DOCUMENTS ||--o{ SCREENING_EVIDENCE : source_of

    SHORTLISTS ||--o{ SHORTLIST_CANDIDATES : contains
    SHORTLIST_CANDIDATES ||--o{ INTERVIEW_PROBES : has

    SHORTLISTS ||--o{ REVIEW_QUEUE_ITEMS : submitted_for_review
